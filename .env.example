# Copy to .env and fill in. Never commit .env — it is gitignored.
# Values marked (public) are safe to expose to the browser. Everything else is server-only.

# ---------------------------------------------------------------------------
# Supabase — auth, storage, Postgres
# Dashboard: https://supabase.com/dashboard/project/<SUPABASE_PROJECT_ID>
# ---------------------------------------------------------------------------

# Project ref, e.g. abcdefghijklmnopqrst
SUPABASE_PROJECT_ID=

# Personal access token for the CLI, from
# https://supabase.com/dashboard/account/tokens
#
# Optional — without it the CLI uses whatever `npm run db:login` last stored. Set it if
# you are signed in to more than one Supabase account on this machine: `supabase login`
# keeps a single token, so the wrong account wins silently and the CLI then reports a
# privileges error rather than a wrong-account one. This pins the repo to the account
# that owns SUPABASE_PROJECT_ID.
SUPABASE_ACCESS_TOKEN=

# (public) https://<SUPABASE_PROJECT_ID>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# (public) Settings → API → anon / publishable key. Safe in the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API → service_role key. Bypasses RLS. Server-only — never expose to the browser.
# Not used by the task-001 scaffold; required by later tasks (storage, admin operations).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web — apps/web
# ---------------------------------------------------------------------------

# (public) Base URL of the versioned public API consumed by web and, later, mobile.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# API — apps/api
# ---------------------------------------------------------------------------

# Same value as NEXT_PUBLIC_SUPABASE_URL. Used to derive the JWT issuer and JWKS URL,
# so the backend can verify Supabase-issued tokens without any shared secret.
SUPABASE_URL=

# JDBC URL for the database the API reads and writes. The schema itself is owned by
# the Supabase CLI (supabase/migrations) — the API never runs migrations.
#   hosted Supabase : jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   local stack     : jdbc:postgresql://localhost:54322/postgres
#
# Use the pooler host, not db.<ref>.supabase.co — the direct host is IPv6-only and most
# home and office networks cannot reach it.
#
# Use port 5432 (session mode), NOT 6543 (transaction mode). Transaction mode hands a
# different backend to each statement, which breaks the server-side prepared statements
# the JDBC driver relies on. If you ever must use 6543, add `prepareThreshold=0`.
DATABASE_URL=

# hosted Supabase : postgres.<SUPABASE_PROJECT_ID>   local stack: postgres
DATABASE_USER=

# hosted Supabase : the database password (Settings → Database)
# local stack     : postgres
DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# Interview engine
#
# Optional. Without it the engine runs a deterministic difficulty ladder over the
# seeded question bank and scores against the rubric directly. With it, follow-up
# selection and scoring become adaptive. Both paths are supported; the report says
# which one produced it.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Notifications — reminders for scheduled interviews
#
# Both are optional. With neither set, the dispatcher logs and marks reminders
# `skipped_no_transport`, which is a supported state rather than a failure.
#
# Email needs a provider account and a verified sending domain. WhatsApp needs a
# WhatsApp Business account, business verification, and per-template approval from
# Meta — allow days for that, not hours.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Supabase CLI — local stack only (`npm run db:start`), needs Docker
#
# The hosted project's Google provider is configured in the dashboard, not here.
# These two configure the same provider for the local stack; the same Google OAuth
# client works if you add http://localhost:54321/auth/v1/callback to its redirect URIs.
# ---------------------------------------------------------------------------

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
