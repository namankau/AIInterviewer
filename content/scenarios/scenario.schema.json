{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untiered Arena scenario",
  "type": "object",
  "required": ["course_slug", "slug", "title", "hook", "context", "tier", "concept_ids", "estimated_minutes", "status", "solution_brief", "steps"],
  "properties": {
    "course_slug": {"type": "string"}, "slug": {"type": "string"},
    "title": {"type": "string"}, "hook": {"type": "string"}, "context": {"type": "string"},
    "tier": {"enum": ["foundations", "intermediate", "advanced", "expert"]},
    "concept_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "estimated_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
    "status": {"enum": ["draft", "reviewed", "live"]},
    "solution_brief": {"type": "string"},
    "steps": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/step"}}
  },
  "additionalProperties": false,
  "$defs": {
    "option": {"type": "object", "required": ["id", "text"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}}, "additionalProperties": false},
    "step": {
      "type": "object",
      "required": ["kind", "step_type", "prompt", "options", "correct_option_id", "explanation", "bottleneck_note", "concept_ids"],
      "properties": {
        "kind": {"enum": ["initial", "probe"]},
        "step_type": {"enum": ["design_choice", "algo_choice", "complexity", "predict_output", "debug", "tradeoff"]},
        "prompt": {"type": "string"}, "context_note": {"type": ["string", "null"]},
        "options": {"type": "array", "minItems": 3, "maxItems": 4, "items": {"$ref": "#/$defs/option"}},
        "correct_option_id": {"type": "string"}, "explanation": {"type": "string"},
        "bottleneck_note": {"type": "string"}, "concept_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "code_snippet": {"type": ["string", "null"]}, "language": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
