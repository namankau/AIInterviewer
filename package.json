{
  "name": "interviewos",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first AI mock interview platform (see docs/InterviewOS_PRD_v1.1.pdf)",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @interviewos/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:link": "supabase link --project-ref moeronogmgtmbdnzfzgu",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:lint": "supabase db lint --level warning"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "supabase": "^2.115.0"
  }
}
